@* Include Bootstrap *@

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap JS (bundle includes Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<html>
    <head>
        <title>Event Registration Application</title>
    </head>

    <body class="bg-light text-dark m-0" style="font-size: 16px;">
        <div class="container text-start">
            <h1 class="text-primary mb-4">
                International Conference on Computer Science and Engineering (Uluslararası Bilgisayar Bilimleri ve Mühendisliği Konferansı - UBMK)
            </h1>
            @RenderBody()
        </div>

        <footer class="bg-dark text-white text-center py-3 mt-4">
            @if(IsSectionDefined("footer")){
                @RenderSection("footer", required: false) <!-- page specific footer -->
            } else {  <!-- default footer -->
                <a href="https://ubmk.org.tr/" target="_blank" class="text-white">
                    2026 International Conference on Computer Science and Engineering - UBMK'26
                </a>
            }

        </footer>

    </body>
</html>




