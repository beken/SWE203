@model List<Item> //specifies that the model for this view is a list of Item objects

@foreach (var item in Model)
{
    <div>
        Name: @item.Name
        -
        Price: @item.Price
    </div>
}

@*This page is a razor view, allows us to mix C# code with HTML*@
@*In this view, we are iterating through the list of items and displaying their details*@
