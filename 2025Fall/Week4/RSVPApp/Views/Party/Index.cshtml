@using RSVPApp.Models
@model List<Guest>

<h3>Who’s coming:</h3>
<table>
    <tbody>
        @foreach(var i in Model){
        <tr>
            @if (i.WillAttend) {
                <td> @i.Name </td>
            }
        </tr>
        }
    </tbody>
</table>

@{
    Layout = "_Layout";
}

@section header {
    <div id="header">
        <h1>Excited to see everyone at the party!</h1>
    </div>
}

@section footer {
    <h6>Can’t wait to have fun together!</h6>
}