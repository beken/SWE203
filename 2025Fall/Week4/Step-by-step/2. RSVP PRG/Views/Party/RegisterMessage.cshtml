@*
send/receive guest info using model
*@

@using RSVPApp.Models
@model Guest

@if(@Model.WillAttend){
    <h3>Thank you for coming to our party @Model.Name !</h3>
}
else{
    <h3>We are sorry to hear you are not coming @Model.Name </h3>
}






@*
send/receive guest info using ViewBag

@if(ViewBag.WillAttend){
    <h3>Thank you for coming to our party @ViewBag.Name !</h3>
    @Html.Partial("_AddressPartial")
}
else{
    <h3>We are sorry to hear you are not coming @ViewBag.Name </h3>
}
*@

