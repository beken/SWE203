@model RSVPApp.Models.Guest


<h2>Join to party:</h2>

<form asp-action="Register" method="post">
    
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label>Name: </label>
        <input type="text" asp-for = "Name"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    
    <div>
        <label>Phone: </label>
        <input type="text" asp-for = "Phone" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    
    <div>
        <label>Email: </label>
        <input type="text" name = "Email" />
    </div>

    <div>
        <label>Are you coming?</label>
        <select name="WillAttend">
            <option value="true">Yes, I will :) </option>
            <option value="false">No, I won't :( </option>
    </select>
    </div>

    <button type="submit">Submit</button>

</form>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>console.log("Scripts section is called");</script>
}