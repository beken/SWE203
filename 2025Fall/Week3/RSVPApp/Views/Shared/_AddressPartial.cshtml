<div class="card border-0 shadow-sm mt-3" style="max-width: 650px;">
    <div class="card-body">
        <h5 class="card-title text-primary">📍 Party Location</h5>

        <p class="card-text mb-1">
            <strong>@ViewBag.AddressName</strong><br />
            @ViewBag.AddressStreet<br />
            @ViewBag.AddressCity, @ViewBag.AddressCountry
        </p>
    </div>
</div>