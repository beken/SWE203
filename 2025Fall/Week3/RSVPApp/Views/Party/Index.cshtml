@using RSVPApp.Models
@model List<Guest>

<h3>Who's coming:</h3>
<table>
    <tbody>
        @foreach(Guest i in Model){
        <tr>
            @if(i.WillAttend){
                <td> @i.Name </td>
            }
        </tr>
        }
    </tbody>
</table>

@{
    Layout = "_Layout";
}

@section header{
    <h1> Excited to see everyone at the party! </h1>
}

@section footer{
    Can't wait to see you!
}