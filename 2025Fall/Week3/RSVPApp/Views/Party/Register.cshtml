<h2>Join to party:</h2>

<form asp-action="Register" method="post">
<div>
    <label>Name: </label>
    <input type="text" name = "Name" />
</div>
<div>
    <label>Phone: </label>
    <input type="text" name = "Phone" />
</div>
<div>
    <label>Email: </label>
    <input type="text" name = "Email" />
</div>
<div>
    <label>Are you coming?:</label>
    <select name="WillAttend">
        <option value = "true">Yes, I am coming :)</option>
        <option value = "false">No, I won't :( </option>
    </select>
</div> 
    <button type="submit">Submit</button>

</form>