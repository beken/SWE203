@* Include Bootstrap *@

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap JS (bundle includes Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>



<html>
<head>
    <title>Party RSVP App</title>
    <style>
        h1 {
            color: #007bff;         
            text-align: left;      
            margin-top: 10px;        
            font-weight: bold;       
            font-family: 'Segoe UI', sans-serif;
        }
    </style>
</head>

<body class="bg-light text-dark m-0">
    <header>
        <div class="container text-start">
            @if(IsSectionDefined("header")){
                @RenderSection("header", required: false) <!-- page specific header -->
            } else {
                <h1 class="text-primary mb-4">We are organizing a home party!</h1>
            }        
        </div>
    </header>

    <main>
        <div class="container text-start">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-light text-muted text-center py-3 border-top">
        @if(IsSectionDefined("footer")){
            @RenderSection("footer", required: false) <!-- page specific footer -->
        } else {
            <small>🎶 Let the fun begin 🎶</small>
        }
    </footer>

</body>



</html>

